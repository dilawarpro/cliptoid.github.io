{
  "id": "/",
  "name": "Cliptoid - TikTok Downloader",
  "short_name": "Cliptoid",
  "description": "Save TikTok videos, audio, captions and slideshow images.",
  "start_url": "/",
  "scope": "/",
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display": "standalone",
  "background_color": "#f7f5fc",
  "theme_color": "#635BFF",
  "icons": [
    {
      "src": "/images/cliptoid-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/cliptoid-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
